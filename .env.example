AWS_PROFILE=se-dev
AWS_REGION=us-east-1
# Required for every deployment; choose exactly one target explicitly.
DEPLOYMENT_ENV=development
# Production defaults preserve the existing customer-facing stack/function.
# Development defaults derive recap-agent-runtime-dev and isolated tables/logs.
STACK_NAME=recap-agent-runtime-dev
FUNCTION_NAME=recap-agent-runtime-dev
TERMINAL_USER_ID=51999999999
TERMINAL_CONTACT_PHONE=
TERMINAL_CHANNEL=terminal_whatsapp
CLI_TIMEOUT_MS=90000

# Optional overrides. If omitted, the CLI resolves these from CloudFormation.
# AGENT_FUNCTION_URL=https://...
# CHANNEL_API_KEY=replace_with_a_random_32_byte_or_longer_secret
# PLANS_TABLE_NAME=recap-agent-runtime-plans
# OPENAI_MODEL=gpt-6-luna
# OPENAI_EXTRACTOR_MODEL=gpt-6-luna
# OPENAI_RESPONSE_CLASSIFIER_MODEL=gpt-6-luna
# RESPONSE_CLASSIFIER_MODE=enforce
# PERF_RETENTION_DAYS=30
# REPLY_PROVIDER_LIMIT=4

# Vector store IDs. Required for hybrid provider search and FAQ knowledge base.
# Get these from your OpenAI dashboard or by running `npm run sync:providers`.
# PROVIDER_VECTOR_STORE_ID=vs_...
# KB_VECTOR_STORE_ID=vs_...
# KB_ENABLED=true
# KB_MAX_RESULTS=6
# KB_SCORE_THRESHOLD=0

# Shared user authentication and Agent API reads/human escalation.
# SINENVOLTURAS_USER_AUTH_BASE_URL=https://api.sinenvolturas.com/api-web/user
# AGENT_API_BASE_URL=https://api.sinenvolturas.com/api/agent
# AGENT_API_TIMEOUT_MS=5000
# AGENT_API_MAX_RETRIES=2
# AGENT_MESSAGE_LOGGING_ENABLED=false
# AGENT_FEATURE_PURCHASE_INFORMATION=true
# AGENT_FEATURE_RSVP=true

# Deployment-only secret source. Do not commit your real value.
OPENAI_API_KEY=replace_me_for_deploy_only
SE_API_KEY=replace_me_for_deploy_only
# Production uses CHANNEL_API_KEY from .env. Development uses DEV_CHANNEL_API_KEY
# from the ignored .env.development file and never rewrites the production key.
DEV_CHANNEL_API_KEY=replace_me_for_development_deploy_only
# CHANNEL_API_KEY=replace_me_for_production_deploy_only

# To promote exactly an already-tested zip, set both values and skip the build:
# DEPLOY_ARTIFACT_PATH=.artifacts/recap-agent.zip
# DEPLOY_ARTIFACT_SHA256=<64-character-hex-sha256>
# Provider sync deployment is opt-in and skipped by default.
# DEPLOY_PROVIDER_SYNC=true
